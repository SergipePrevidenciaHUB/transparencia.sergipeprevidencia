__pycache__/
*.pyc
.DS_Store
_site/

# Prévias e arquivos de trabalho locais; preservar fora do versionamento
/trabalho/

# Arquivos internos de entrada; manter apenas a estrutura de pastas
/dados-entrada/**
!/dados-entrada/**/
!/dados-entrada/**/.gitkeep
# Somente o ensaio sintético autorizado é reproduzível/versionado; fontes reais seguem ignoradas.
!/dados-entrada/testes-serigy/despesas-sinteticas.json
!/dados-entrada/testes-serigy/despesas-base-sem-dados.json
# Documentos locais utilizados como referência
referencias/*
!referencias/.gitkeep

{
  "totais": "<section id=\"totais\" class=\"content-box\" aria-labelledby=\"titulo-totais\" serigySchema=\"https://serigy.tce.se.gov.br/comum/despesas.html\">\n      <h2 id=\"titulo-totais\">Totais das despesas</h2>\n      <p><strong>Aguardando dados oficiais:</strong> totais empenhados, liquidados e pagos, com identificação do exercício e do mês ou período de referência. A consulta e o download estão indisponíveis até a disponibilização dos dados.</p>\n      <form id=\"despesas-totais-filtro\" class=\"filter-panel\" aria-label=\"Consulta de totais das despesas\" aria-describedby=\"despesas-totais-status\">\n        <div class=\"field\"><label for=\"despesas-totais-ano\">Exercício</label><select id=\"despesas-totais-ano\" name=\"ano\" disabled><option value=\"\">Exercícios aguardando dados</option></select></div>\n        <div class=\"field\"><label for=\"despesas-totais-mes\">Mês</label><select id=\"despesas-totais-mes\" name=\"mes\" disabled><option value=\"\">Todos os meses disponíveis</option><option value=\"1\">Janeiro</option><option value=\"2\">Fevereiro</option><option value=\"3\">Março</option><option value=\"4\">Abril</option><option value=\"5\">Maio</option><option value=\"6\">Junho</option><option value=\"7\">Julho</option><option value=\"8\">Agosto</option><option value=\"9\">Setembro</option><option value=\"10\">Outubro</option><option value=\"11\">Novembro</option><option value=\"12\">Dezembro</option></select></div>\n        <div class=\"field\"><label for=\"despesas-totais-uo\">Unidade Orçamentária</label><select id=\"despesas-totais-uo\" name=\"codigo_uo\" disabled><option value=\"\">Todas as unidades</option><option value=\"37201\">37201 — SergipePrevidência</option><option value=\"37202\">37202 — SPSM</option><option value=\"37401\">37401 — FINANPREV</option><option value=\"37403\">37403 — FUNPREV</option></select></div>\n        <div class=\"filter-actions\"><button type=\"submit\" serigyExecuteWaitSection=\"despesasTotaisTabela\" disabled>Pesquisar</button><button type=\"reset\" serigyClearForm disabled>Limpar</button></div>\n      </form>\n      <p id=\"despesas-totais-status\" role=\"status\" aria-live=\"polite\">Consulta indisponível enquanto os dados oficiais não forem disponibilizados.</p>\n      <p>“Todas as unidades” apresentará os registros identificados por UO e período, sem gerar um total entre unidades ou entre períodos.</p>\n      <button id=\"despesas-totais-csv\" type=\"button\" disabled>Baixar recorte em CSV — indisponível</button>\n      <div id=\"despesas-totais-resultados\" class=\"table-wrap\" hidden>\n        <table id=\"despesas-totais-tabela\" serigyLoadSection=\"despesasTotaisTabela\">\n          <caption>Totais das despesas por unidade e período</caption>\n          <thead><tr><th scope=\"col\">Unidade Orçamentária</th><th scope=\"col\">Exercício</th><th scope=\"col\">Mês</th><th scope=\"col\">Empenhado (R$)</th><th scope=\"col\">Liquidado (R$)</th><th scope=\"col\">Pago (R$)</th></tr></thead>\n          <tbody></tbody>\n        </table>\n      </div>\n      <!-- Inserir somente referência de atualização comprovada, com dataUltimaAtualizacao sob este schema. -->\n      <div id=\"despesas-totais-atualizacao\" class=\"update-info\" hidden></div>\n    </section>",
  "classificacao": "<section id=\"classificacao\" class=\"content-box\" aria-labelledby=\"titulo-classificacao\" serigySchema=\"https://serigy.tce.se.gov.br/comum/despesas.html\">\n      <h2 id=\"titulo-classificacao\">Despesas por classificação orçamentária</h2>\n      <p><strong>Aguardando dados oficiais:</strong> despesas com os códigos e as descrições da unidade orçamentária, função, subfunção, natureza da despesa (categoria econômica, grupo e elemento) e fonte dos recursos. Consulta e download indisponíveis até a disponibilização dos dados.</p>\n      <form id=\"despesas-classificacao-filtro\" class=\"filter-panel\" aria-label=\"Consulta da classificação orçamentária\" aria-describedby=\"despesas-classificacao-status\">\n        <div class=\"field\"><label for=\"despesas-classificacao-ano\">Exercício</label><select id=\"despesas-classificacao-ano\" name=\"ano\" disabled><option value=\"\">Exercícios aguardando dados</option></select></div>\n        <div class=\"field\"><label for=\"despesas-classificacao-mes\">Mês</label><select id=\"despesas-classificacao-mes\" name=\"mes\" disabled><option value=\"\">Todos os meses disponíveis</option><option value=\"1\">Janeiro</option><option value=\"2\">Fevereiro</option><option value=\"3\">Março</option><option value=\"4\">Abril</option><option value=\"5\">Maio</option><option value=\"6\">Junho</option><option value=\"7\">Julho</option><option value=\"8\">Agosto</option><option value=\"9\">Setembro</option><option value=\"10\">Outubro</option><option value=\"11\">Novembro</option><option value=\"12\">Dezembro</option></select></div>\n        <div class=\"field\"><label for=\"despesas-classificacao-uo\">Unidade Orçamentária</label><select id=\"despesas-classificacao-uo\" name=\"codigo_uo\" disabled><option value=\"\">Todas as unidades</option><option value=\"37201\">37201 — SergipePrevidência</option><option value=\"37202\">37202 — SPSM</option><option value=\"37401\">37401 — FINANPREV</option><option value=\"37403\">37403 — FUNPREV</option></select></div>\n        <div class=\"field\"><label for=\"despesas-classificacao-elemento\">Elemento de despesa</label><select id=\"despesas-classificacao-elemento\" name=\"elemento\" disabled><option value=\"\">Elementos aguardando dados</option></select></div>\n        <div class=\"filter-actions\"><button type=\"submit\" serigyExecuteWaitSection=\"despesasClassificacaoTabela\" disabled>Pesquisar</button><button type=\"reset\" serigyClearForm disabled>Limpar</button></div>\n      </form>\n      <p id=\"despesas-classificacao-status\" role=\"status\" aria-live=\"polite\">Consulta indisponível enquanto os dados oficiais não forem disponibilizados.</p>\n      <p>A navegação da natureza da despesa apresentará Categoria Econômica → Grupo → Elemento. Função/subfunção e fonte permanecem identificadas nas linhas. “Todas as unidades” lista os registros por UO e período, sem total conjunto.</p>\n      <button id=\"despesas-classificacao-csv\" type=\"button\" disabled>Baixar recorte em CSV — indisponível</button>\n      <div id=\"despesas-classificacao-resultados\" class=\"table-wrap\" hidden>\n        <table id=\"despesas-classificacao-tabela\" serigyLoadSection=\"despesasClassificacaoTabela\">\n          <caption>Classificação orçamentária por unidade e período — códigos e descrições</caption>\n          <thead><tr><th scope=\"col\">Unidade Orçamentária</th><th scope=\"col\">Exercício</th><th scope=\"col\">Mês</th><th scope=\"col\">Função</th><th scope=\"col\">Subfunção</th><th scope=\"col\">Categoria Econômica</th><th scope=\"col\">Grupo</th><th scope=\"col\">Elemento de Despesa</th><th scope=\"col\">Fonte dos Recursos</th></tr></thead>\n          <tbody></tbody>\n        </table>\n      </div>\n      <!-- Marcar dataUltimaAtualizacao somente quando houver referência real de atualização/cobertura. -->\n      <div id=\"despesas-classificacao-atualizacao\" class=\"update-info\" hidden></div>\n    </section>",
  "empenhos": "<section id=\"empenhos\" class=\"content-box\" aria-labelledby=\"titulo-empenhos\" serigySchema=\"https://serigy.tce.se.gov.br/comum/despesas.html\">\n      <h2 id=\"titulo-empenhos\">Consulta de empenhos</h2>\n      <p>As informações oficiais de empenhos ainda serão disponibilizadas.</p>\n      <form id=\"despesas-empenhos-filtro\" class=\"filter-panel\" aria-label=\"Consulta de empenhos\" aria-describedby=\"despesas-empenhos-status\">\n        <div class=\"field\"><label for=\"despesas-empenhos-ano\">Exercício</label><select id=\"despesas-empenhos-ano\" name=\"ano\" disabled><option value=\"\">Exercícios indisponíveis</option></select></div>\n        <div class=\"field\"><label for=\"despesas-empenhos-mes\">Mês</label><select id=\"despesas-empenhos-mes\" name=\"mes\" disabled><option value=\"\">Todos os meses disponíveis</option><option value=\"1\">Janeiro</option><option value=\"2\">Fevereiro</option><option value=\"3\">Março</option><option value=\"4\">Abril</option><option value=\"5\">Maio</option><option value=\"6\">Junho</option><option value=\"7\">Julho</option><option value=\"8\">Agosto</option><option value=\"9\">Setembro</option><option value=\"10\">Outubro</option><option value=\"11\">Novembro</option><option value=\"12\">Dezembro</option></select></div>\n        <div class=\"field\"><label for=\"despesas-empenhos-uo\">Unidade Orçamentária</label><select id=\"despesas-empenhos-uo\" name=\"codigo_uo\" disabled><option value=\"\">Unidades indisponíveis</option></select></div>\n        <div class=\"field\"><label for=\"despesas-empenhos-numero-empenho\">Número do empenho</label><input id=\"despesas-empenhos-numero-empenho\" name=\"numero_empenho\" type=\"search\" disabled></div>\n        <div class=\"field\"><label for=\"despesas-empenhos-credor\">Nome do credor</label><input id=\"despesas-empenhos-credor\" name=\"credor\" type=\"search\" disabled></div>\n        <div class=\"field\"><label for=\"despesas-empenhos-documento\">CPF/CNPJ do credor — identificador sintético</label><input id=\"despesas-empenhos-documento\" name=\"documento\" type=\"search\" disabled></div>\n        <div class=\"filter-actions\"><button type=\"submit\" disabled serigyExecuteWaitSection=\"despesasEmpenhosTabela\">Pesquisar</button><button type=\"reset\" disabled serigyClearForm>Limpar</button></div>\n      </form>\n      <p id=\"despesas-empenhos-status\" role=\"status\" aria-live=\"polite\">Consulta indisponível enquanto os dados oficiais não forem disponibilizados.</p>\n      <p>Os detalhes de cada empenho serão apresentados na própria linha, incluindo a identificação do procedimento quando aplicável.</p>\n      <button id=\"despesas-empenhos-csv\" type=\"button\" disabled>Baixar recorte em CSV — indisponível</button>\n      <div id=\"despesas-empenhos-resultados\" class=\"table-wrap\" hidden>\n        <table id=\"despesas-empenhos-tabela\" serigyLoadSection=\"despesasEmpenhosTabela\">\n          <caption>Empenhos por unidade e período, com identificação e detalhes da contratação</caption>\n          <thead><tr><th scope=\"col\">Unidade Orçamentária</th><th scope=\"col\">Exercício</th><th scope=\"col\">Mês</th><th scope=\"col\">Número do empenho</th><th scope=\"col\">Credor</th><th scope=\"col\">CPF/CNPJ — identificador sintético inválido</th><th scope=\"col\">Valor do empenho (R$)</th><th scope=\"col\">Bem fornecido ou serviço prestado</th><th scope=\"col\">Modalidade</th><th scope=\"col\">Número do procedimento sintético</th></tr></thead>\n          <tbody></tbody>\n        </table>\n      </div>\n      <div id=\"despesas-empenhos-atualizacao\" class=\"update-info\" hidden></div>\n    </section>"
}
